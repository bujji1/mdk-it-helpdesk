@page "/tickets/{Id:int}"
@rendermode InteractiveServer
@using MdkHelpdesk.Application.DTOs
@using MdkHelpdesk.Application.Interfaces
@inject ITicketService TicketService
@inject IUserService UserService

<PageTitle>Ticket #@Id - MDK IT Helpdesk</PageTitle>

@if (_isLoading)
{
    <p><em>Loading ticket...</em></p>
}
else if (_ticket is null)
{
    <div class="alert alert-warning">Ticket #@Id was not found.</div>
    <a class="btn btn-secondary" href="/">Back to Tickets</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 mb-0">Ticket #@_ticket.Id: @_ticket.Title</h1>
        <div>
            <a class="btn btn-primary me-2" href="/tickets/@_ticket.Id/edit">Edit</a>
            <a class="btn btn-outline-secondary" href="/">Back to List</a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="detail-grid">
                <dt>Status</dt>
                <dd><span class="badge @TicketStatusDisplay.BadgeClass(_ticket.Status)">@TicketStatusDisplay.Label(_ticket.Status)</span></dd>
                <dt>Assigned To</dt>
                <dd>@(_ticket.AssignedUserName ?? "Unassigned")</dd>
                <dt>Created (UTC)</dt>
                <dd>@_ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>Last Updated (UTC)</dt>
                <dd>@_ticket.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </dl>
            <hr />
            <h2 class="h5">Description</h2>
            <p class="mb-0" style="white-space: pre-wrap;">@_ticket.Description</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="assignee">Assign To</label>
                    <select id="assignee" class="form-select" @bind="_selectedUserId">
                        <option value="">-- Unassigned --</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary" @onclick="AssignAsync" disabled="@(_isAssigning || _selectedUserId == _ticket.AssignedUserId)">
                        @(_isAssigning ? "Saving..." : "Update Assignee")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_assignMessage))
            {
                <div class="text-success mt-2" role="status">@_assignMessage</div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TicketResponse? _ticket;
    private IReadOnlyList<UserResponse> _users = Array.Empty<UserResponse>();
    private int? _selectedUserId;
    private bool _isLoading = true;
    private bool _isAssigning;
    private string? _assignMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _assignMessage = null;
        _users = await UserService.GetAllAsync();
        _ticket = await TicketService.GetByIdAsync(Id);
        _selectedUserId = _ticket?.AssignedUserId;
        _isLoading = false;
    }

    private async Task AssignAsync()
    {
        _isAssigning = true;
        _assignMessage = null;

        var updated = await TicketService.AssignAsync(Id, _selectedUserId);
        if (updated is not null)
        {
            _ticket = updated;
            _assignMessage = updated.AssignedUserName is null
                ? "Ticket is now unassigned."
                : $"Ticket assigned to {updated.AssignedUserName}.";
        }
        else
        {
            // The ticket disappeared between loading and saving.
            _ticket = null;
        }

        _isAssigning = false;
    }
}
