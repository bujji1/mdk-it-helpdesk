@page "/"
@rendermode InteractiveServer
@using MdkHelpdesk.Application.DTOs
@using MdkHelpdesk.Application.Interfaces
@using MdkHelpdesk.Domain.Enums
@inject ITicketService TicketService
@inject IUserService UserService

<PageTitle>Support Tickets - MDK IT Helpdesk</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-0">Support Tickets</h1>
        <small class="text-muted">Internal IT Helpdesk</small>
    </div>
    <a class="btn btn-primary" href="/tickets/new">+ New Ticket</a>
</div>

<div class="card mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="statusFilter">Filter by Status</label>
            <select id="statusFilter" class="form-select" @bind="SelectedStatus" @bind:after="LoadTicketsAsync">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<TicketStatus>())
                {
                    <option value="@status">@TicketStatusDisplay.Label(status)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="userFilter">Filter by Assigned User</label>
            <select id="userFilter" class="form-select" @bind="SelectedAssignee" @bind:after="LoadTicketsAsync">
                <option value="">All Users</option>
                <option value="@UnassignedOption">Unassigned</option>
                @foreach (var user in _users)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@(!HasFilters)">Clear Filters</button>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <p><em>Loading tickets...</em></p>
}
else if (_tickets.Count == 0)
{
    <div class="alert alert-info">
        @(HasFilters ? "No tickets match the selected filters." : "There are no tickets yet.")
    </div>
}
else
{
    <p class="text-muted small mb-2">Showing @_tickets.Count ticket@(_tickets.Count == 1 ? "" : "s")</p>
    <div class="card table-responsive">
        <table class="table table-hover align-middle ticket-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Created (UTC)</th>
                    <th>Updated (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in _tickets)
                {
                    <tr>
                        <td class="ticket-id">#@ticket.Id</td>
                        <td>
                            <a href="/tickets/@ticket.Id" class="fw-semibold text-decoration-none">@ticket.Title</a>
                        </td>
                        <td>
                            <span class="badge @TicketStatusDisplay.BadgeClass(ticket.Status)">@TicketStatusDisplay.Label(ticket.Status)</span>
                        </td>
                        <td>@(ticket.AssignedUserName ?? "Unassigned")</td>
                        <td class="ticket-date">@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="ticket-date">@ticket.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<TicketResponse> _tickets = Array.Empty<TicketResponse>();
    private IReadOnlyList<UserResponse> _users = Array.Empty<UserResponse>();
    private bool _isLoading = true;

    private const string UnassignedOption = "unassigned";

    private TicketStatus? SelectedStatus { get; set; }

    // "" = all users, "unassigned" = tickets with no assignee, otherwise a user ID.
    private string SelectedAssignee { get; set; } = string.Empty;

    private bool HasFilters => SelectedStatus.HasValue || SelectedAssignee.Length > 0;

    protected override async Task OnInitializedAsync()
    {
        _users = await UserService.GetAllAsync();
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        _isLoading = true;
        var unassignedOnly = SelectedAssignee == UnassignedOption;
        int? userId = int.TryParse(SelectedAssignee, out var parsed) ? parsed : null;

        _tickets = await TicketService.GetTicketsAsync(SelectedStatus, userId, unassignedOnly);
        _isLoading = false;
    }

    private async Task ClearFiltersAsync()
    {
        SelectedStatus = null;
        SelectedAssignee = string.Empty;
        await LoadTicketsAsync();
    }
}
